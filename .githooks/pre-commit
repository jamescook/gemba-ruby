#!/bin/sh
# Activate once per clone: git config core.hooksPath .githooks
#
# This repo has no lint/typecheck tooling wired into a hook (retired,
# no longer developed - see README.md) - this hook exists solely to
# keep this repo's own bead/tracker ids (teek-mgba-xxx) out of source.
set -eu

# Refuse bead/tracker ids anywhere in the tree. Beads is internal to the
# workflow; a bead id in a comment or doc means nothing to a reader and
# leaks the internal process into permanent history. Checks the STAGED
# content (git grep --cached), not the working tree, so this can't be
# fooled by fixing a file without re-staging it.
staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$staged" ]; then
  hits=$(git grep -n --cached -E 'teek-mgba-[a-z0-9]{3}(\.[0-9]+)*([^a-zA-Z]|$)' -- . ':!.githooks' ':!.claude' ':!.beads' 2>/dev/null || true)
  if [ -n "$hits" ]; then
    echo "pre-commit: refusing to commit bead/tracker id(s):" >&2
    printf '%s\n' "$hits" >&2
    echo "Describe the change/rationale itself instead of pointing at the bead." >&2
    exit 1
  fi
fi
